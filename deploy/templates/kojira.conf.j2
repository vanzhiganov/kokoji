# Managed by Ansible -- role deploy. Do not edit by hand.
[kojira]

; Username/password authentication against the hub
user = {{ koji_kojira_user }}
password = {{ koji_kojira_password }}

; The URL of the Koji hub server
server = {{ koji_hub_url }}

; The directory containing the repos/ directory
topdir = {{ koji_topdir }}

; Log file
logfile = {{ koji_kojira_logfile }}
